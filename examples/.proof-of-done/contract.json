{
  "mode": "standard",
  "plan_path": ".proof-of-done/plan.md",
  "requirements": [
    {
      "id": "R1",
      "text": "Signed-out users are redirected to /login",
      "gate": "task-auth-redirect"
    },
    {
      "id": "R2",
      "text": "Authentication integration remains valid",
      "gate": "feature-auth"
    }
  ],
  "final_gate": "feature-auth",
  "gates": [
    {
      "id": "task-auth-redirect",
      "level": "task",
      "checks": [
        {
          "id": "auth-test",
          "type": "command",
          "argv": ["npm", "test", "--", "auth"],
          "expect_exit": 0
        },
        {
          "id": "redirect-behavior",
          "type": "http",
          "url": "http://localhost:3000/dashboard",
          "expect_status": 302,
          "expect_headers": {"location": "/login"}
        }
      ]
    },
    {
      "id": "feature-auth",
      "level": "feature",
      "depends_on": ["task-auth-redirect"],
      "checks": [
        {
          "id": "typecheck",
          "type": "command",
          "argv": ["npm", "run", "typecheck"],
          "expect_exit": 0
        }
      ]
    }
  ]
}
